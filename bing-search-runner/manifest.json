{
  "manifest_version": 3,
  "name": "Bing Search Runner",
  "version": "1.2.1",
  "description": "Tìm kiếm theo lịch trong một tab Bing, với số lượt và thời gian chờ tùy chọn.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.bing.com/*", "https://bing.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://www.bing.com/*", "https://bing.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_title": "Bing Search Runner", "default_popup": "popup.html" }
}
